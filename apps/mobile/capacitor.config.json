{
  "appId": "online.taxiim.app",
  "appName": "TAXI IM",
  "webDir": "www",
  "server": {
    "url": "https://www.taxiim.online",
    "cleartext": false,
    "allowNavigation": [
      "www.taxiim.online",
      "taxiim.online"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "useLegacyBridge": true
  },
  "ios": {
    "contentInset": "never"
  },
  "backgroundColor": "#111113",
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    },
    "LocalNotifications": {
      "smallIcon": "ic_tracking",
      "iconColor": "#7ce4f7"
    }
  }
}
