# Variable names only. Leave values empty here and set them in the environment.
# Never commit real passwords, tokens, or database URLs.

# Postgres connection. If unset, the app uses embedded PGLite and applies migrations itself.
DATABASE_URL=

# Optional Mapbox token. Read on the server only. If unset, routing is OSRM (no live traffic)
# and the map uses Esri imagery through /api/tiles.
MAPBOX_ACCESS_TOKEN=
MAP_API_KEY=

# Auth. Local email/password works without these. Set them for a deployed origin.
# BETTER_AUTH_SECRET is required whenever DATABASE_URL is set (generate with: openssl rand -hex 32).
VITE_AUTH_ENABLED=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Optional extra origins allowed to sign in, comma separated (e.g. a custom domain).
BETTER_AUTH_TRUSTED_ORIGINS=

# Administrator account. Required with DATABASE_URL: it is created (or its password reset)
# on the first request after deploy. Password: 8-72 characters, at least one letter and one number.
TAXI_ADMIN_EMAIL=
TAXI_ADMIN_PASSWORD=
TAXI_ADMIN_NAME=

# Optional. JSON list that sets driver logins once per change, matched by email or name, e.g.
# [{"name":"Florim Ferizi","email":"florim@example.com","password":"Example1"}]
TAXI_DRIVER_LOGINS=

# Optional. When set, the five sample driver logins are created with this password.
# Leave empty in production and create real drivers under Accounts instead.
TAXI_DEMO_PASSWORD=

# Optional broker sign-in. Not required for the local desk and driver login.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PROJECT_ID=
GROK_GATE_ORIGIN=
GROK_CONNECTORS_URL=
GROK_CONNECTOR_ACCESS_TOKEN=

# Optional publish / share-card hostnames. Not required to run locally.
VITE_PUBLIC_HOSTNAME=
VITE_PROJECT_ID=
VITE_GROK_EXTENSIONS=
VITE_OG_SERVICE_URL=
