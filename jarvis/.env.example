# Copy to your secret store / hosting env. Never commit real values.
NODE_ENV=production
PORT=8787
HOST=0.0.0.0
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JARVIS_MASTER_KEY=
# One-time token for first-run owner setup (random if unset; printed to the console once).
JARVIS_SETUP_TOKEN=
# PostgreSQL. Unset => embedded PGlite under JARVIS_DATA_DIR.
DATABASE_URL=
JARVIS_DATA_DIR=./.data
# LLM provider (operator chat + web research). Unset => those features report "not configured".
ANTHROPIC_API_KEY=
JARVIS_LLM_MODEL=claude-opus-5-5
JARVIS_LLM_EFFORT=medium
JARVIS_SESSION_TTL_HOURS=12
JARVIS_PUBLIC_ORIGIN=
# Set to "off" to disable the in-process scheduler (e.g. when using an external cron).
JARVIS_SCHEDULER=
# Owner-designated proceeds wallet (public address; network NOT assumed).
JARVIS_DESIGNATED_WALLET=0x3ddab2dd97a234e72d09bcbda77d0519e351ecae
